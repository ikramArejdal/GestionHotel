  <property name="styleSheet">
   <string notr="true">QMainWindow {
        background-color: #f4f4f4;
}
QTabWidget::pane {
        border: 1px solid #C2C7CB;
        background: white;
}
QTabBar::tab {
        background: #e1e1e1;
        border: 1px solid #C4C4C3;
        padding: 10px 20px;
        font-weight: bold;
}
QTabBar::tab:selected {
        background: white;
        border-bottom-color: white;
}
QLineEdit {
        padding: 5px;
        border: 1px solid #ccc;
        border-radius: 3px;
}
QPushButton {
        background-color: #28a745;
        color: white;
        padding: 6px 12px;
        border-radius: 4px;
        font-weight: bold;
}
QPushButton:hover {
        background-color: #218838;
}
QTableWidget {
        gridline-color: #ccc;
        font-size: 13px;
}
QHeaderView::section {
        background-color: #007bff;
        color: white;
        padding: 5px;
        border: none;
}</string>
