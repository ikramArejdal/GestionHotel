           <item><widget class="QLineEdit" name="txtEmpSalaire"><property name="placeholderText"><string>Salaire</string></property></widget></item>
           
           <item><widget class="QPushButton" name="btnAjouterEmp"><property name="text"><string>Ajouter</string></property></widget></item>
